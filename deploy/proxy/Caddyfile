# Caddy: HTTPS automático (Let's Encrypt) y reparto por dominio.
{
	email {$CORREO}
}

# Configuración común a los dos ambientes:
#   {args[0]} contenedor de oTree · {args[1]} clave REST de oTree
(simulador) {
	encode gzip

	# La raíz muestra la portada (oTree mandaría a las demos).
	redir / /static/portada/index.html 302

	# Las páginas estáticas (portada, tablero docente) se revalidan siempre, para que después
	# de una actualización nadie quede con una copia vieja. Sus estilos y scripts llevan ?v=.
	@html path *.html
	header @html Cache-Control "no-cache"

	# API REST de oTree (la usa el tablero docente). Se entra con el login de oTree:
	# 1) Solo se aceptan pedidos con el encabezado X-Tablero, que pone el tablero y que una
	#    página de otro sitio no puede agregar (defensa contra pedidos falsificados).
	# 2) Caddy le pregunta a oTree si el navegador tiene la sesión de administración iniciada
	#    (/server_check exige login). Si la tiene, agrega la clave REST que pide oTree (nunca
	#    llega al navegador) y deja pasar el pedido; si no, responde 401 y el tablero muestra
	#    su ventana de ingreso.
	route /api/* {
		@sin_marca not header X-Tablero 1
		respond @sin_marca "Pedido no permitido" 403

		reverse_proxy {args[0]}:8000 {
			method GET
			rewrite /server_check
			@con_sesion status 2xx
			handle_response @con_sesion {
				request_header otree-rest-key {args[1]}
			}
			handle_response {
				respond "Hay que iniciar sesión" 401
			}
		}
		reverse_proxy {args[0]}:8000
	}

	# Caddy maneja los websockets de oTree (páginas de espera, monitor) sin configuración extra.
	reverse_proxy {args[0]}:8000
}

{$DOMINIO_PRODUCCION} {
	import simulador simulador-produccion {$REST_KEY_PRODUCCION}
}

{$DOMINIO_TESTING} {
	import simulador simulador-testing {$REST_KEY_TESTING}
	# Para que los buscadores no indexen el ambiente de pruebas.
	header X-Robots-Tag "noindex, nofollow"
}
